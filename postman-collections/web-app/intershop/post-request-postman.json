    {
      "name": "Создание карточки товара",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "// Этот скрипт выполняется после POST-запроса на создание карточки товара.\r",
              "// Он берет JSON-ответ от API, достает из него поле id созданного товара\r",
              "// и сохраняет этот id в переменную коллекции productid.\r",
              "// \r",
              "// Благодаря этому в следующих запросах можно не подставлять id вручную,\r",
              "// а использовать переменную {{productid}}, например:\r",
              "// GET {{baseurl}}/api/products/{{productid}}\r",
              "//\r",
              "// Цепочка:\r",
              "// POST создал товар → скрипт сохранил его id → GET/PUT/DELETE используют {{productid}}\r",
              "\r",
              "var jsonData = pm.response.json();\r",
              "\r",
              "pm.collectionVariables.set(\"productid\", jsonData.id);\r",
              "\r",
              "var jsonData = pm.response.json();\r",
              "\r",
              "pm.collectionVariables.set(\"productid\", jsonData.id);"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
