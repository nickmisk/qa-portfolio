  "item": [
    {
      "name": "Получение списка товаров",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "// этот скрипт берет рандомный ID из списка товаров и вставляет его значение в переменную productid. Удобно, чтобы в запросе на получение карточки отдельного товара не вводить ID вручную. Чтобы при выполнении запроса на получение отдельной карточки товара всякий раз возвращалась новая рандомная карточка, сначала выполняешь запрос на получение списка ВСЕХ товаров (скрипт отрабатывает), потом уже запрос на получение рандомной карточки.//\r",
              "\r",
              "const response = pm.response.json();\r",
              "\r",
              "const products = Array.isArray(response) ? response : response.products;\r",
              "\r",
              "if (!products || products.length === 0) {\r",
              "    throw new Error(\"Список товаров пустой или не найден\");\r",
              "}\r",
              "\r",
              "const randomProduct = products[Math.floor(Math.random() * products.length)];\r",
              "\r",
              "pm.collectionVariables.set(\"productid\", randomProduct.id);\r",
              "\r",
              "console.log(\"Random productid:\", randomProduct.id);"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseurl}}api/products/",
          "host": [
            "{{baseurl}}api"
          ],
          "path": [
            "products",
            ""
          ]
        }
      },
      "response": []
    },
    {
      "name": "Получение карточки отдельного товара",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseurl}}api/products/{{productid}}",
          "host": [
            "{{baseurl}}api"
          ],
          "path": [
            "products",
            "{{productid}}"
          ]
        }
      },
      "response": []
    }
  ],
